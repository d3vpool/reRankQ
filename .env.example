# reRankQ Environment Variables

# API Keys (for generation) — only the provider configured in configs/default.yaml is used
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Configuration
RERANKQ_CONFIG=configs/default.yaml

# Optional: Logging
LOG_LEVEL=INFO
LOG_FILE=logs/rerankq.log
